# --- Serveur ---
NODE_ENV=development
PORT=4000
# Origines autorisées (séparées par des virgules en production)
CLIENT_ORIGIN=http://localhost:5173

# --- Base de données ---
# En local : fichier SQLite. En production : voir README (PostgreSQL recommandé).
DATABASE_URL="file:./dev.db"

# --- Porte / sécurité ---
# Code demandé par l'interface avant toute commande. À CHANGER en production.
ACCESS_CODE=smartdoor-demo
# Durée d'ouverture (secondes) et durée d'un jeton de session (minutes)
OPEN_DURATION_SECONDS=6
SESSION_TTL_MINUTES=480

# --- IoT ---
# demo = données simulées (aucune commande réelle)
# blynk = commandes envoyées à Blynk (nécessite BLYNK_AUTH_TOKEN)
IOT_MODE=demo

# --- Blynk IoT (à remplir plus tard) ---
# Jeton d'authentification Blynk — NE JAMAIS COMMITTER CE FICHIER.
BLYNK_AUTH_TOKEN=
BLYNK_BASE_URL=https://blynk.cloud/external/api
BLYNK_PIN_DISTANCE=V0
BLYNK_PIN_PIR=V1
BLYNK_PIN_DOOR_STATE=V2
BLYNK_PIN_ALARM=V3
BLYNK_PIN_DOOR_COMMAND=V4
BLYNK_PIN_BUZZER=V5
BLYNK_TIMEOUT_MS=5000
