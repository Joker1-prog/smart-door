
# --- Serveur ---
NODE_ENV=development
PORT=4000

# Origines autorisées (séparées par des virgules en production)
CLIENT_ORIGIN=http://localhost:5173

# --- Base de données ---
# En local : fichier SQLite.
# En production : PostgreSQL recommandé.
DATABASE_URL="file:./dev.db"

# --- Porte / sécurité ---
# Code demandé par l'interface avant toute commande.
# À CHANGER en production.
ACCESS_CODE=smartdoor-demo

# Durée d'ouverture (secondes) et durée d'un jeton de session (minutes)
OPEN_DURATION_SECONDS=6
SESSION_TTL_MINUTES=480

# --- IoT ---
# demo = données simulées (aucune commande réelle)
# blynk = commandes envoyées à Blynk
# Nécessite BLYNK_AUTH_TOKEN et un ESP32 connecté.
IOT_MODE=demo

# --- Blynk IoT ---
# Jeton d'authentification Blynk.
# Ne jamais publier le véritable jeton.
# Ne jamais committer un fichier .env contenant ce jeton.
BLYNK_AUTH_TOKEN=

# URL de l'API Blynk
BLYNK_BASE_URL=https://blynk.cloud/external/api

# --- Datastreams Blynk ---

# V0 : Distance (ESP32 -> Blynk)
BLYNK_PIN_DISTANCE=V0

# V1 : Capteur_PIR (ESP32 -> Blynk)
BLYNK_PIN_PIR=V1

# V2 : Door_Status (ESP32 -> Blynk)
BLYNK_PIN_DOOR_STATE=V2

# V3 : Alarm_Status (ESP32 -> Blynk)
BLYNK_PIN_ALARM=V3

# V4 : Open_Command (Blynk -> ESP32)
BLYNK_PIN_DOOR_COMMAND=V4

# V5 : Alarm_Command (Blynk -> ESP32)
BLYNK_PIN_ALARM_COMMAND=V5

# Délai maximal des requêtes vers Blynk (millisecondes)
BLYNK_TIMEOUT_MS=5000
